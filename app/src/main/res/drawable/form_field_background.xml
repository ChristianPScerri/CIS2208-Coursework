<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/quickcart_field" />
            <stroke
                android:width="2dp"
                android:color="@color/quickcart_primary" />
            <corners android:radius="@dimen/form_field_radius" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/quickcart_field_subtle" />
            <stroke
                android:width="1dp"
                android:color="@color/quickcart_border" />
            <corners android:radius="@dimen/form_field_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/quickcart_field" />
            <stroke
                android:width="1dp"
                android:color="@color/quickcart_border" />
            <corners android:radius="@dimen/form_field_radius" />
        </shape>
    </item>
</selector>
