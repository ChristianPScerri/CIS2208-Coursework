<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/quickcart_field" />
            <stroke
                android:width="1dp"
                android:color="@color/quickcart_border" />
            <corners android:radius="@dimen/form_field_radius" />
        </shape>
    </item>
    <item
        android:gravity="end|center_vertical"
        android:end="10dp"
        android:width="24dp"
        android:height="24dp"
        android:drawable="@drawable/ic_arrow_drop_down" />
</layer-list>
