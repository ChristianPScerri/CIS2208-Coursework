<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="#FFFFFF"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/textview_recipe_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#193326"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="Tomato Pasta" />

    <TextView
        android:id="@+id/textview_recipe_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#4D6659"
        android:textSize="14sp"
        tools:text="Suggested from pantry ingredient" />

    <TextView
        android:id="@+id/textview_open_recipe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/open_recipe"
        android:textColor="@color/quickcart_primary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
