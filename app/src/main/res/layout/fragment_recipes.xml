<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF7"
    tools:context=".RecipesFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textview_recipes_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recipes_title"
            android:textColor="#193326"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textview_recipes_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/recipes_subtitle"
            android:textColor="#4D6659"
            android:textSize="14sp" />

        <Button
            android:id="@+id/button_fetch_recipes"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="@string/fetch_recipes" />

        <TextView
            android:id="@+id/textview_recipe_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/recipes_empty"
            android:textColor="#4D6659"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_recipes"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_recipe" />

        <TextView
            android:id="@+id/textview_receipt_image_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/receipt_image_title"
            android:textColor="#193326"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageview_receipt_preview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:contentDescription="@string/receipt_image_title"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/textview_image_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/no_image_selected"
            android:textColor="#4D6659"
            android:textSize="14sp" />

        <Button
            android:id="@+id/button_choose_gallery_image"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/choose_gallery_image" />

        <Button
            android:id="@+id/button_take_camera_photo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/take_camera_photo" />

    </LinearLayout>
</ScrollView>
