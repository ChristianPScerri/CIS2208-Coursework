<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quickcart_background"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".RecipesFragment">

    <TextView
        android:id="@+id/textview_recipes_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recipes_title"
        android:textColor="@color/quickcart_primary_dark"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textview_recipes_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/recipes_subtitle"
        android:textColor="#4D6659"
        android:textSize="14sp" />

    <TextView
        style="@style/QuickCart.FormLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/recipes_choose_ingredient" />

    <EditText
        android:id="@+id/edittext_search_recipe_ingredients"
        style="@style/QuickCart.FormEditText"
        android:hint="@string/recipes_search_ingredients"
        android:inputType="text" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipgroup_pantry_ingredients"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="false"
            app:singleLine="true" />
    </HorizontalScrollView>

    <Button
        android:id="@+id/button_fetch_recipes"
        style="@style/QuickCart.PrimaryButton"
        android:layout_marginTop="14dp"
        android:text="@string/fetch_recipes" />

    <TextView
        android:id="@+id/textview_recipe_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/recipes_empty"
        android:textColor="#4D6659"
        android:textSize="14sp" />

    <Button
        android:id="@+id/button_add_pantry_from_recipes"
        style="@style/QuickCart.PrimaryButton"
        android:layout_marginTop="12dp"
        android:text="@string/add_pantry_items"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview_recipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_recipe" />

</LinearLayout>
