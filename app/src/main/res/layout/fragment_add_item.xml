<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quickcart_background"
    android:fillViewport="true"
    tools:context=".AddItemFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/form_screen_padding"
        android:paddingTop="18dp"
        android:paddingEnd="@dimen/form_screen_padding"
        android:paddingBottom="96dp">

        <TextView
            style="@style/QuickCart.FormSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/item_details_section" />

        <TextView
            style="@style/QuickCart.FormLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/form_gap"
            android:text="@string/shopping_item_name_hint" />

        <EditText
            android:id="@+id/edittext_item_name"
            style="@style/QuickCart.FormEditText"
            android:hint="@string/shopping_item_name_hint"
            android:inputType="textCapWords" />

        <TextView
            style="@style/QuickCart.FormLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/form_gap"
            android:text="@string/item_quantity_hint" />

        <EditText
            android:id="@+id/edittext_item_quantity"
            style="@style/QuickCart.FormEditText"
            android:hint="@string/item_quantity_hint"
            android:inputType="textCapWords" />

        <TextView
            style="@style/QuickCart.FormLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/form_gap"
            android:text="@string/item_amount_hint" />

        <EditText
            android:id="@+id/edittext_item_amount"
            style="@style/QuickCart.FormEditText"
            android:hint="@string/item_amount_hint"
            android:inputType="number" />

        <TextView
            style="@style/QuickCart.FormSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/form_section_gap"
            android:text="@string/category_date_section" />

        <TextView
            style="@style/QuickCart.FormLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/form_gap"
            android:text="@string/item_category_hint" />

        <FrameLayout
            style="@style/QuickCart.DropdownContainer">

            <Spinner
                android:id="@+id/spinner_item_category"
                style="@style/QuickCart.FormDropdown"
                android:prompt="@string/item_category_hint" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@string/item_category_hint"
                android:src="@drawable/ic_arrow_drop_down" />
        </FrameLayout>

        <TextView
            style="@style/QuickCart.FormLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/form_gap"
            android:text="@string/item_priority_hint" />

        <FrameLayout
            style="@style/QuickCart.DropdownContainer">

            <Spinner
                android:id="@+id/spinner_item_priority"
                style="@style/QuickCart.FormDropdown"
                android:prompt="@string/item_priority_hint" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@string/item_priority_hint"
                android:src="@drawable/ic_arrow_drop_down" />
        </FrameLayout>

        <TextView
            style="@style/QuickCart.FormLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/form_gap"
            android:text="@string/item_notes_hint" />

        <EditText
            android:id="@+id/edittext_item_notes"
            style="@style/QuickCart.FormEditText"
            android:layout_height="92dp"
            android:gravity="top"
            android:hint="@string/item_notes_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:paddingTop="14dp"
            android:singleLine="false" />

        <TextView
            style="@style/QuickCart.FormSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/form_section_gap"
            android:text="@string/product_image" />

        <FrameLayout
            android:id="@+id/container_item_image"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/image_placeholder_background"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imageview_item_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/product_image"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:id="@+id/layout_item_image_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@string/product_image"
                    android:src="@drawable/ic_photo_placeholder" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/image_empty_title"
                    android:textColor="@color/quickcart_primary_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/image_empty_helper"
                    android:textColor="@color/quickcart_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <Button
            android:id="@+id/button_choose_item_image"
            style="@style/QuickCart.SecondaryButton"
            android:layout_marginTop="10dp"
            android:text="@string/choose_product_image" />

        <Button
            android:id="@+id/button_save_item"
            style="@style/QuickCart.PrimaryButton"
            android:layout_marginTop="@dimen/form_section_gap"
            android:text="@string/save_item" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
