<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/pantry_item_normal"
    android:elevation="2dp"
    android:minHeight="76dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageview_pantry_item"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:background="#F1F5F2"
            android:contentDescription="@string/product_image"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textview_pantry_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#193326"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Rice" />
    </LinearLayout>

    <TextView
        android:id="@+id/textview_pantry_item_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#4D6659"
        android:textSize="14sp"
        tools:text="1 bag - Pantry - Expires: No expiry set" />

    <TextView
        android:id="@+id/textview_pantry_expiry_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#E8F5E9"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="#1B5E20"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="OK" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_edit_pantry_item"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/edit_item" />

        <Button
            android:id="@+id/button_add_pantry_expiry"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="@string/add_expiry"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_delete_pantry_item"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="@string/delete_item" />

    </LinearLayout>
</LinearLayout>
