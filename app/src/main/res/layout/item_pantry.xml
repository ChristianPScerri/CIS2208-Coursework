<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="#FFFFFF"
    android:elevation="2dp"
    android:minHeight="76dp"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/textview_pantry_item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#193326"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="Rice" />

    <TextView
        android:id="@+id/textview_pantry_item_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#4D6659"
        android:textSize="14sp"
        tools:text="1 bag - Pantry - Expires: No expiry set" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_edit_pantry_item"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/edit_item" />

        <Button
            android:id="@+id/button_delete_pantry_item"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="@string/delete_item" />

    </LinearLayout>
</LinearLayout>
