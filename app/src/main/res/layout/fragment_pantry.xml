<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF7"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".PantryFragment">

    <TextView
        android:id="@+id/textview_pantry_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pantry_title"
        android:textColor="#193326"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textview_pantry_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/pantry_subtitle"
        android:textColor="#4D6659"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textview_pantry_expired_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#E8F5E9"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/pantry_expired_summary"
        android:textColor="#1B5E20"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Expired items: 0" />

    <EditText
        android:id="@+id/edittext_search_pantry"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:autofillHints=""
        android:background="#FFFFFF"
        android:hint="@string/pantry_search_hint"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="#26352D"
        android:textColorHint="#6C7B72" />

    <TextView
        android:id="@+id/textview_empty_pantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/pantry_empty"
        android:textColor="#4D6659"
        android:visibility="gone" />

    <Button
        android:id="@+id/button_empty_add_pantry_item"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="@string/add_pantry_item_title"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview_pantry_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_pantry" />

</LinearLayout>
